{
  "manifest_version": 3,
  "name": "Carnet — ajouter la page",
  "short_name": "Carnet",
  "version": "0.3.0",
  "description": "Ajoute à une tâche ou un objet Carnet la page courante (lien), une image (capture, image de la page, fichier, presse-papiers) ou un document (fichier, page ou lien), avec une description.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ajouter à Carnet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Ouvrir Carnet sur la page courante"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://todo.jaume-eric.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
